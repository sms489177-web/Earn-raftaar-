<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Earn Raftaar Support</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#000;
height:100vh;
overflow:hidden;
display:flex;
justify-content:center;
align-items:center;
}

.container{
width:100%;
max-width:1080px;
height:100vh;
position:relative;
overflow:hidden;
}

.bg{
position:absolute;
inset:0;
width:100%;
height:100%;
object-fit:cover;
z-index:1;
}

.content{
position:relative;
z-index:2;
height:100%;
display:flex;
flex-direction:column;
align-items:center;
padding:20px;
}

.top{
display:flex;
align-items:center;
justify-content:center;
gap:20px;
margin-top:10px;
}

.logo{
width:110px;
}

.brand{
font-size:42px;
font-weight:900;
color:white;
}

.brand span{
color:#b83cff;
}

.support{
margin-top:15px;
padding:12px 30px;
border:2px solid #b83cff;
border-radius:50px;
color:white;
font-size:22px;
}

.sub{
margin-top:25px;
color:white;
font-size:26px;
font-weight:700;
}

.main1{
margin-top:20px;
font-size:90px;
font-weight:900;
color:white;
text-align:center;
line-height:1;
}

.main2{
font-size:95px;
font-weight:900;
background:linear-gradient(#d77cff,#8c00ff);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
text-align:center;
line-height:1;
}

.contact{
margin-top:20px;
font-size:30px;
font-weight:700;
color:white;
}

.contact span{
color:#00ff38;
}

.whatsapp{
margin-top:20px;
display:block;
width:90%;
max-width:900px;
}

.whatsapp img{
width:100%;
display:block;
}

.cards{
margin-top:25px;
display:flex;
justify-content:center;
gap:12px;
width:100%;
}

.cards img{
width:18%;
border-radius:20px;
}

.bar{
margin-top:25px;
width:95%;
}

.bar img{
width:100%;
}

.rating{
display:flex;
align-items:center;
justify-content:center;
gap:15px;
margin-top:20px;
}

.rating img{
height:90px;
}

.stars{
font-size:70px;
color:#FFD700;
}

.rate{
font-size:55px;
font-weight:900;
color:#b83cff;
}

.bottom{
margin-top:20px;
width:95%;
}

.bottom img{
width:100%;
}

@media(max-width:768px){

.brand{
font-size:22px;
}

.logo{
width:60px;
}

.main1{
font-size:50px;
}

.main2{
font-size:55px;
}

.cards{
gap:5px;
}

.cards img{
width:19%;
}

.rate{
font-size:30px;
}

.stars{
font-size:35px;
}
}
</style>
</head>

<body>

<div class="container">

<img src="background.png" class="bg">

<div class="content">

<div class="top">
<img src="er-logo.png" class="logo">
<div class="brand">
EARN RAFTAAR | <span>AGENCY SUPPORT</span>
</div>
</div>

<div class="support">
🎧 ONLINE SUPPORT 24/7
</div>

<div class="sub">
NEW HOSTING ID CREATE SUPPORT
</div>

<div class="main1">
HOST ID & AGENCY
</div>

<div class="main2">
SETUP PROBLEM?
</div>

<div class="contact">
CONTACT US FROM <span>WHATSAPP</span>
</div>

<a class="whatsapp"
href="https://wa.me/919999999999">
<img src="whatsapp-button.png">
</a>

<div class="cards">
<img src="card1.png">
<img src="card2.png">
<img src="card3.png">
<img src="card4.png">
<img src="card5.png">
</div>

<div class="bar">
<img src="trust-bar-1.png">
</div>

<div class="rating">
<img src="avatars.png">
<div>
<div class="stars">★★★★★</div>
<div class="rate">4.9/5 SUPPORT RATING</div>
</div>
</div>

<div class="bottom">
<img src="trust-bar-2.png">
</div>

</div>
</div>

</body>
</html>
