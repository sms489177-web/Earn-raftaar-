<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Earn Raftaar - Agency Support</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #07020d;
            --purple-neon: #a945f7;
            --purple-light: #d88eff;
            --purple-dark: #2a0a4a;
            --green-btn-top: #1ed144;
            --green-btn-bot: #0a821e;
            --green-glow: #38ff5d;
            --text-main: #ffffff;
            --card-bg-top: #1c0934;
            --card-bg-bot: #090212;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(65, 17, 122, 0.6) 0%, transparent 60%),
                radial-gradient(circle at 50% 80%, rgba(42, 10, 74, 0.4) 0%, transparent 50%);
        }

        /* Abstract glowing curve background effect */
        .bg-glow {
            position: absolute;
            top: 25%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 150vw;
            height: 500px;
            border-bottom: 2px solid rgba(169, 69, 247, 0.3);
            border-radius: 50%;
            box-shadow: 0 50px 100px rgba(169, 69, 247, 0.2);
            z-index: -1;
            pointer-events: none;
        }

        .container {
            width: 100%;
            max-width: 600px; /* Kept tight to mirror the mobile/poster ratio */
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            z-index: 1;
        }

        /* Header Section */
        .header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 5px;
            flex-wrap: wrap;
        }

        .logo-circle {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #000;
            border-top: 2px solid #fff;
            border-right: 2px solid #fff;
            border-bottom: 2px solid #f00;
            border-left: 2px solid #f00;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 20px;
            letter-spacing: -1px;
            box-shadow: 0 0 10px rgba(255, 0, 0, 0.3);
        }

        .logo-circle .e { color: #ff2a2a; }
        .logo-circle .r { color: #ffffff; }

        .brand-text {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 24px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .brand-text .earn { color: #ffffff; }
        .brand-text .divider { color: #555; font-weight: 400; }
        .brand-text .agency { 
            color: var(--purple-light);
            text-shadow: 0 0 10px rgba(216, 142, 255, 0.5);
        }

        /* Support Badge */
        .support-badge-wrapper {
            display: flex;
            justify-content: center;
        }

        .support-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(20, 5, 40, 0.8);
            border: 1.5px solid var(--purple-neon);
            padding: 6px 20px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            box-shadow: 0 0 10px rgba(169, 69, 247, 0.4), inset 0 0 8px rgba(169, 69, 247, 0.2);
        }

        .support-badge svg {
            width: 16px;
            height: 16px;
            fill: var(--purple-light);
        }

        /* Headings */
        .headings-container {
            text-align: center;
            margin-top: 10px;
        }

        .sub-heading {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            color: #eaeaea;
            margin-bottom: 10px;
        }

        .sub-heading::before, .sub-heading::after {
            content: "";
            height: 2px;
            width: 40px;
            background: var(--purple-neon);
            box-shadow: 0 0 5px var(--purple-neon);
        }

        .main-heading {
            font-size: 42px;
            font-weight: 900;
            line-height: 1.1;
            text-transform: uppercase;
        }

        .main-heading .white-text {
            color: #ffffff;
            display: block;
        }

        .main-heading .purple-text {
            background: linear-gradient(to right, #b45aff, #e899ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
            filter: drop-shadow(0 0 12px rgba(232, 153, 255, 0.4));
        }

        /* CTA Section */
        .cta-section {
            text-align: center;
            margin: 15px 0;
        }

        .cta-subtitle {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .cta-subtitle span {
            color: #25d366;
        }

        .emoji-pointers {
            font-size: 24px;
            margin-bottom: 10px;
            display: block;
        }

        .whatsapp-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background: linear-gradient(180deg, var(--green-btn-top) 0%, var(--green-btn-bot) 100%);
            border: 3px solid var(--green-glow);
            border-radius: 50px;
            padding: 16px 20px;
            text-decoration: none;
            color: #ffffff;
            font-size: 22px;
            font-weight: 800;
            box-shadow: 0 0 25px rgba(56, 255, 93, 0.4), inset 0 0 15px rgba(56, 255, 93, 0.4);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            width: 100%;
        }

        .whatsapp-btn:active {
            transform: scale(0.98);
        }

        .whatsapp-btn svg {
            width: 32px;
            height: 32px;
            fill: #ffffff;
        }

        /* Services Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin: 10px 0;
        }

        .service-card {
            background: linear-gradient(180deg, var(--card-bg-top), var(--card-bg-bot));
            border: 1px solid rgba(169, 69, 247, 0.6);
            border-radius: 12px;
            padding: 12px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            box-shadow: 0 4px 15px rgba(169, 69, 247, 0.15);
        }

        .card-icon {
            width: 50px;
            height: 50px;
            margin-bottom: 10px;
            position: relative;
        }

        .card-icon svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));
        }

        .card-title {
            font-size: 10px;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.3;
            text-transform: uppercase;
        }
        
        .card-title .purple-highlight {
            color: var(--purple-light);
        }

        /* Trust Banner */
        .trust-banner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(169, 69, 247, 0.3);
            border-bottom: 1px solid rgba(169, 69, 247, 0.3);
            padding: 15px 0;
            margin: 5px 0;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 600;
        }

        .trust-item svg {
            width: 24px;
            height: 24px;
        }

        /* Ratings Section */
        .ratings-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(20, 5, 40, 0.5);
            border-radius: 40px;
            padding: 10px 20px;
            margin: 5px 0;
        }

        .avatars {
            display: flex;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid var(--purple-neon);
            margin-left: -15px;
            background-color: #222;
            background-size: cover;
            background-position: center;
        }

        .avatar:first-child { margin-left: 0; }

        .rating-info {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .stars {
            color: #ffc107;
            font-size: 18px;
            letter-spacing: 2px;
            margin-bottom: 4px;
        }

        .rating-text {
            font-size: 14px;
            font-weight: 700;
        }

        .rating-text .score { color: var(--purple-light); }

        /* Bottom Features */
        .bottom-features {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 5px;
            border-top: 1px solid rgba(169, 69, 247, 0.3);
            padding-top: 15px;
            margin-bottom: 20px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .feature-item svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        /* Responsive Adjustments */
        @media (max-width: 650px) {
            .services-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .brand-text { font-size: 18px; }
            .main-heading { font-size: 32px; }
            .whatsapp-btn { font-size: 18px; padding: 12px 15px; }
            .trust-banner, .bottom-features { flex-wrap: wrap; justify-content: center; gap: 15px; }
            .bottom-features { grid-template-columns: repeat(2, 1fr); gap: 15px; }
            .trust-item { width: 100%; justify-content: center; }
            .trust-banner { flex-direction: column; }
            .ratings-section { flex-direction: column; gap: 15px; text-align: center; border-radius: 20px;}
            .rating-info { align-items: center; }
        }
        
        @media (max-width: 400px) {
            .services-grid { grid-template-columns: repeat(2, 1fr); }
            .service-card:last-child { grid-column: span 2; }
        }
    </style>
</head>
